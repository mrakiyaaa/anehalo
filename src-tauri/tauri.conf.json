{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anehalo",
  "version": "0.1.0",
  "identifier": "me.lakshitha.anehalo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anehalo",
        "decorations": false,
        "visible": false,
        "dragDropEnabled": false,
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: http: data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http:; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$DOCUMENT/Anehalo/.attachments/**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Lakshitha",
    "shortDescription": "Private Markdown notes on your desktop",
    "longDescription": "Anehalo is a local-first Markdown notes app for writing, organizing, linking, searching, and exporting your notes.",
    "copyright": "Copyright © 2026 Lakshitha",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
